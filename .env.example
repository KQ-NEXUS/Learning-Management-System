# Copy to .env and fill in. Never commit .env (PRD PAY-14).

# --- Database --------------------------------------------------------------
# Development uses Neon. Self-hosted production uses the Compose Postgres:
#   postgresql://lms:<password>@localhost:5432/lms?schema=public
DATABASE_URL="postgresql://lms:lms@localhost:5432/lms?schema=public"

# --- Docker Compose (self-hosted) ------------------------------------------
POSTGRES_USER=lms
POSTGRES_PASSWORD=
POSTGRES_DB=lms
POSTGRES_PORT=5432

# --- Private object storage (S3-compatible) -------------------------------
# D-35: MinIO for local dev and CI, Cloudflare R2 in production. Both speak
# the S3 API, so application code reads S3_* only — the values below are the
# only thing that changes between environments. Real credentials never enter
# source control (PAY-14); every value here is a placeholder.
#
# Dev-only: consumed by the docker-compose MinIO service, not by the app.
MINIO_ROOT_USER=lms-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
#
# Application storage config — working local (MinIO) defaults:
S3_BUCKET=lms-private
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=lms-minio
S3_SECRET_ACCESS_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
#
# Production (Cloudflare R2) — uncomment and fill in, delete the MinIO values:
#   S3_BUCKET=<your-r2-bucket>
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  # or a custom domain bound to the bucket
#   S3_ACCESS_KEY_ID=<r2-api-token-access-key-id>
#   S3_SECRET_ACCESS_KEY=<r2-api-token-secret>
#   S3_FORCE_PATH_STYLE=false

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Email (Postmark) ------------------------------------------------------
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="KQ Nexus <no-reply@example.com>"

# --- Payments --------------------------------------------------------------
# Deployment-managed secrets. Never exposed in the browser, exports, audit
# detail, or any staff UI (PRD PAY-14).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
