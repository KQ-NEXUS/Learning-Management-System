# Copy to .env and fill in. Never commit .env (PRD PAY-14).

# --- Database --------------------------------------------------------------
# Development uses Neon. Self-hosted production uses the Compose Postgres:
#   postgresql://lms:<password>@localhost:5432/lms?schema=public
DATABASE_URL="postgresql://lms:lms@localhost:5432/lms?schema=public"

# --- Docker Compose (self-hosted) ------------------------------------------
POSTGRES_USER=lms
POSTGRES_PASSWORD=
POSTGRES_DB=lms
POSTGRES_PORT=5432

# --- Private object storage (S3-compatible) -------------------------------
# D-35: MinIO for local dev and CI, Cloudflare R2 in production. Both speak
# the S3 API, so application code reads S3_* only — the values below are the
# only thing that changes between environments. Real credentials never enter
# source control (PAY-14); every value here is a placeholder.
#
# Dev-only: consumed by the docker-compose MinIO service, not by the app.
MINIO_ROOT_USER=lms-minio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
#
# Application storage config — working local (MinIO) defaults. Browsers upload
# with short-lived presigned PUT URLs and download with short-lived presigned
# GET URLs; no file body passes through the app.
S3_BUCKET=lms-private
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=lms-minio
S3_SECRET_ACCESS_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
#
# Production (Cloudflare R2) — uncomment and fill in, delete the MinIO values:
#   S3_BUCKET=<your-r2-bucket>
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  # or a custom domain bound to the bucket
#   S3_ACCESS_KEY_ID=<r2-api-token-access-key-id>
#   S3_SECRET_ACCESS_KEY=<r2-api-token-secret>
#   S3_FORCE_PATH_STYLE=false

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Email (Postmark) ------------------------------------------------------
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="KQ Nexus <no-reply@example.com>"

# --- Payments --------------------------------------------------------------
# Deployment-managed secrets. Never exposed in the browser, exports, audit
# detail, or any staff UI (PRD PAY-14). Read only through
# src/server/payments/settlement-config.ts (Paystack/school identifiers) or
# src/server/payments/providers/stripe/client.ts (Stripe secret key).
#
# Stripe: direct USD Checkout (Phase 6) and USD Connect destination charges
# to the school's connected account (Phase 7, D-04).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
#
# Stripe Connect: this deployment's one school's connected account id
# (D-02, D-04, D-05). Onboarded via the Stripe Dashboard -> Connect ->
# Accounts, outside the LMS — the LMS only ever reads this id.
STRIPE_CONNECTED_ACCOUNT_ID=acct_xxx
#
# Paystack: NGN split-payment checkout (Phase 7). Paystack signs webhook
# payloads with this SAME secret key — there is no separate webhook secret
# to configure (see paystackWebhookSecretKey() in settlement-config.ts).
PAYSTACK_SECRET_KEY=sk_test_xxx
#
# Paystack: this deployment's one school's subaccount code (D-02, D-03,
# D-05). Created via the Paystack Dashboard -> Settings -> Subaccounts —
# never via the LMS or an API call this codebase makes.
PAYSTACK_SUBACCOUNT_CODE=ACCT_xxx


BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER_NAME="Professional Training LMS"
EMAIL_SENDER_ADDRESS=no-reply@example.com
APP_BASE_URL=http://localhost:3000
# --- Support (REG-05 receipt support route) --------------------------------
# REG-05 requires the order receipt page to carry a real support-contact
# route. No static value exists anywhere in this codebase or its docs (see
# 06-08-SUMMARY.md); this placeholder mirrors EMAIL_SENDER_ADDRESS's dev
# convention above and MUST be replaced with the deployment's real support
# inbox before go-live.
SUPPORT_CONTACT_EMAIL=support@example.com
