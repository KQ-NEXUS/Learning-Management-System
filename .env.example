# Copy to .env and fill in. Never commit .env (PRD PAY-14).

# --- Database --------------------------------------------------------------
# Development uses Neon. Self-hosted production uses the Compose Postgres:
#   postgresql://lms:<password>@localhost:5432/lms?schema=public
DATABASE_URL="postgresql://lms:lms@localhost:5432/lms?schema=public"

# --- Docker Compose (self-hosted) ------------------------------------------
POSTGRES_USER=lms
POSTGRES_PASSWORD=
POSTGRES_DB=lms
POSTGRES_PORT=5432

# --- Private object storage (MinIO / S3-compatible) ------------------------
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=lms-private
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Email (Postmark) ------------------------------------------------------
POSTMARK_SERVER_TOKEN=
EMAIL_FROM="KQ Nexus <no-reply@example.com>"

# --- Payments --------------------------------------------------------------
# Deployment-managed secrets. Never exposed in the browser, exports, audit
# detail, or any staff UI (PRD PAY-14).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=


BREVO_API_KEY=your-brevo-api-key
EMAIL_SENDER_NAME="Professional Training LMS"
EMAIL_SENDER_ADDRESS=no-reply@example.com
APP_BASE_URL=http://localhost:3000