# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference documents — large binaries, distributed out of band
*.docx
~$*.docx

# Secrets — never in source control (PRD PAY-14)
.env
.env.*
!.env.example

# Superpowers working documents — specs and implementation plans
docs/superpowers/

# Track task list — local working document
docs/TRACK-A-TASKS.md

# Playwright MCP session artifacts
.playwright-mcp/

# Local tooling and planning scratch — not part of the shipped repo
design/
.claude/
.planning/
reference/
.worktrees/
# Playwright CLI output (may contain credentials)
.playwright-cli/
